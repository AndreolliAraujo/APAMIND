# Normalização de fim de linha do repositório.
# Texto: LF no índice e no checkout em qualquer sistema operacional.
* text=auto eol=lf

# Scripts Windows mantêm CRLF no checkout (convenção da plataforma).
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários: nunca normalizar nem tentar diff textual.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
